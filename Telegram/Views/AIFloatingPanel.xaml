<UserControl\n    x:Class=\"Telegram.Views.AIFloatingPanel\"\n    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\n    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\n    xmlns:d=\"http://schemas.microsoft.com/expression/blend/2008\"\n    xmlns:mc=\"http://schemas.openxmlformats.org/markup-compatibility/2006\"\n    mc:Ignorable=\"d\"\n    Width=\"320\"\n    Height=\"Auto\"\n    MaxHeight=\"500\">\n\n    <Grid Background=\"{ThemeResource NavigationViewItemBackground}\" \n          BorderThickness=\"1\" \n          BorderBrush=\"{ThemeResource CardStrokeColorDefaultBrush}\"\n          CornerRadius=\"12\"\n          Padding=\"12\"\n          RowSpacing=\"8\">\n        <Grid.RowDefinitions>\n            <RowDefinition Height=\"Auto\"/>\n            <RowDefinition Height=\"*\"/>\n            <RowDefinition Height=\"Auto\"/>\n        </Grid.RowDefinitions>\n\n        <!-- Header with Close Button -->\n        <Grid Grid.Row=\"0\">\n            <Grid.ColumnDefinitions>\n                <ColumnDefinition Width=\"*\"/>\n                <ColumnDefinition Width=\"Auto\"/>\n            </Grid.ColumnDefinitions>\n            \n            <StackPanel Orientation=\"Horizontal\" Spacing=\"8\" VerticalAlignment=\"Center\">\n                <FontIcon Glyph=\"&#xEBD3;\" Foreground=\"{ThemeResource SystemAccentColor}\" FontSize=\"16\"/>\n                <TextBlock Text=\"AI Assistant\" FontWeight=\"SemiBold\"/>\n            </StackPanel>\n            \n            <Button Grid.Column=\"1\" \n                    Content=\"✕\" \n                    Background=\"Transparent\"\n                    Click=\"OnCloseClick\"\n                    Padding=\"4\"/>\n        </Grid>\n\n        <!-- Status Indicator -->\n        <TextBlock Grid.Row=\"0\" \n                   x:Name=\"StatusIndicator\" \n                   Text=\"● Ready\" \n                   Foreground=\"{ThemeResource SystemAccentColor}\"\n                   FontSize=\"11\"\n                   HorizontalAlignment=\"Right\"\n                   Margin=\"0,0,40,0\"/>\n\n        <!-- Response Display -->\n        <ScrollViewer Grid.Row=\"1\" \n                      BorderThickness=\"0,1,0,1\" \n                      BorderBrush=\"{ThemeResource DividerStrokeColorDefaultBrush}\"\n                      Padding=\"0,8\">\n            <TextBlock x:Name=\"ResponseText\"\n                       Text=\"Select text and use AI actions\"\n                       TextWrapping=\"Wrap\"\n                       Foreground=\"{ThemeResource TextFillColorSecondaryBrush}\"\n                       FontSize=\"13\"\n                       IsTextSelectionEnabled=\"True\"/>\n        </ScrollViewer>\n\n        <!-- Action Buttons -->\n        <GridView Grid.Row=\"2\" \n                  ItemsSource=\"{x:Bind AIActions}\" \n                  SelectionMode=\"None\"\n                  IsItemClickEnabled=\"True\"\n                  ItemClick=\"OnActionClick\">\n            <GridView.ItemTemplate>\n                <DataTemplate>\n                    <Button Content=\"{Binding Label}\" \n                            Width=\"72\"\n                            Background=\"{ThemeResource AccentButtonBackground}\"\n                            Padding=\"4,8\"\n                            FontSize=\"11\"/>\n                </DataTemplate>\n            </GridView.ItemTemplate>\n        </GridView>\n    </Grid>\n</UserControl>\n
<UserControl
    x:Class="Telegram.Views.AIAssistantView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Telegram.Views"
    xmlns:controls="using:Telegram.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="12" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="AI Assistant" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock x:Name="StatusText" Text="AI is ready" Foreground="{ThemeResource SystemAccentColor}" FontSize="12"/>
        </StackPanel>

        <!-- AI Response Display -->
        <ScrollViewer Grid.Row="1" BorderThickness="1" BorderBrush="{ThemeResource ControlElevationBorderBrush}" CornerRadius="8">
            <TextBlock
                x:Name="ResponseText"
                Text="Enter text and select an action"
                TextWrapping="Wrap"
                Padding="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"/>
        </ScrollViewer>

        <!-- Action Buttons -->
        <CommandBar Grid.Row="2" Background="Transparent" DefaultLabelPosition="Bottom">
            <AppBarButton
                Icon="Summarize"
                Label="Summarize"
                x:Name="SummarizeButton"
                Click="OnSummarizeClick"/>
            <AppBarButton
                Icon="Edit"
                Label="Rewrite"
                x:Name="RewriteButton"
                Click="OnRewriteClick"/>
            <AppBarButton
                Icon="World"
                Label="Translate"
                x:Name="TranslateButton"
                Click="OnTranslateClick"/>
            <AppBarButton
                Icon="Refresh"
                Label="Ask AI"
                x:Name="GenerateButton"
                Click="OnGenerateClick"/>
        </CommandBar>
    </Grid>
</UserControl>
